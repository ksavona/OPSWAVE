# Copy this file to .env for local development. Never commit real credentials.
APP_BASE_URL=http://localhost:3000
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
NEXT_TELEMETRY_DISABLED=1
TRUST_PROXY=false
AUTH_RATE_LIMIT_PEPPER=replace-with-at-least-32-random-characters

POSTGRES_DB=opsweave
POSTGRES_USER=opsweave
OPSWEAVE_POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-a-local-only-password
DATABASE_URL=postgresql://opsweave:replace-with-a-local-only-password@127.0.0.1:5432/opsweave
TEST_DATABASE_URL=postgresql://opsweave:replace-with-a-local-test-password@127.0.0.1:55432/opsweave_test

# Optional. Required only for explicitly enabled live-provider development checks.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-sol
OPSWAVE_MEMORY_DIR=/var/lib/opsweave/memory
ATTACHMENT_STORAGE_PATH=/var/lib/opsweave/attachments

# Collaboration. Keep the same invitation key available to web and worker processes.
# Generate 32 random bytes and base64-encode them. Rotating it invalidates queued invitation email payloads.
INVITATION_LINK_ENCRYPTION_KEY=
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_TOKEN=
# Required before delegate uploads are enabled. The endpoint must accept multipart `file` and return {"clean":true}.
ATTACHMENT_SCANNER_ENDPOINT=
ATTACHMENT_SCANNER_TOKEN=
# Recommended open-source deployment scanner. Keep clamd bound to loopback or a private network.
CLAMAV_HOST=
CLAMAV_PORT=3310
OPSWEAVE_CLAMAV_PORT=3310

# Required for Settings-managed AI credentials. Generate 32 random bytes and base64-encode them.
AI_CREDENTIAL_MASTER_KEY=
AI_CREDENTIAL_MASTER_KEY_VERSION=1
