# Copy this file to .env for local development. Never commit real credentials.
APP_BASE_URL=http://localhost:3000
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
NEXT_TELEMETRY_DISABLED=1

POSTGRES_DB=opsweave
POSTGRES_USER=opsweave
POSTGRES_PASSWORD=replace-with-a-local-only-password
DATABASE_URL=postgresql://opsweave:replace-with-a-local-only-password@127.0.0.1:5432/opsweave
TEST_DATABASE_URL=postgresql://opsweave:replace-with-a-local-test-password@127.0.0.1:55432/opsweave_test

# Optional. Required only for explicitly enabled live-provider development checks.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-sol

# Required for Settings-managed AI credentials. Generate 32 random bytes and base64-encode them.
AI_CREDENTIAL_MASTER_KEY=
AI_CREDENTIAL_MASTER_KEY_VERSION=1
